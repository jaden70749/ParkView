# Hikvision main stream example:
# rtsp://USERNAME:PASSWORD@192.168.0.20:554/Streaming/Channels/101
PARKVIEW_CAMERA_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/Streaming/Channels/101
PARKVIEW_CAMERA_NAME=1층 주차장 CCTV
PARKVIEW_CAMERA_SOCKET_TIMEOUT=3
PARKVIEW_SITE_ID=site-1
PARKVIEW_FLOOR_ID=B1

PARKVIEW_ANALYSIS_INTERVAL=30
PARKVIEW_MODEL_PATH=/opt/parkview/models/yolov5su.pt
PARKVIEW_REGIONS_PATH=/var/lib/parkview/parking_regions.json
PARKVIEW_IMAGE_SIZE=640
PARKVIEW_CONFIDENCE=0.25
PARKVIEW_VEHICLE_CLASSES=car,truck,bus,motorcycle
PARKVIEW_EMPTY_CONFIRMATIONS=2
PARKVIEW_DEBUG=false
PARKVIEW_ALLOW_DIAGNOSTIC_UPLOADS=false
PARKVIEW_CALIBRATION_MODE=false
PARKVIEW_ADMIN_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# Browser map SDK. This value is public at runtime, but keep it out of Git.
KAKAO_JAVASCRIPT_KEY=

# Optional HTTPS backend used by GitHub Pages and native mobile builds.
PARKVIEW_EDGE_API_BASE_URL=

# Server-only AI credentials. Never expose this value to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PARKVIEW_AI_ALLOW_PRIVATE_NETWORK=true

# Optional Firebase Realtime Database publishing.
FIREBASE_DATABASE_URL=
FIREBASE_AUTH_TOKEN=
PARKVIEW_FIREBASE_PATH=parkview/site-1/B1/slots
